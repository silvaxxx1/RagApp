APP_NAME="RagApp"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB

POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="RagApp"



# ========================= LLM Config =========================
GENERATION_BACKEND="openai"
# EMBEDDING_BACKEND="cohere"
EMBEDDING_BACKEND="open_source_embeddings"  # 👈 new option



OPENAI_API_KEY=""
OPENAI_API_URL=""   # just add ngrok url here 
COHERE_API_KEY=""

GENERATION_MODEL_ID="gpt-3.5-turbo-0125"
# EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
# EMBEDDING_MODEL_SIZE=384 

EMBEDDING_MODEL_ID="intfloat/e5-large-v2"  # 👈 default for your new provider
EMBEDDING_MODEL_SIZE=1024  # 👈 matches your provider default

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ================== Vector DB Config ======================#
VECTOR_DB_BACKEND  = "QDRANT"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_METHOD = "cosine"

# ======================== Template Config===================#
DEFAULT_LANG = "en"
PRIMARAY_LANG = "en"